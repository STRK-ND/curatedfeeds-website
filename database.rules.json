{
  "rules": {
    "presence": {
      ".read": true,
      ".indexOn": ["t"],
      "$session": {
        ".write": "!newData.exists() || (newData.hasChild('t') && newData.child('t').isNumber())",
        ".validate": "!newData.exists() || newData.hasChildren(['t'])"
      }
    },
    "stats": {
      ".read": true,
      "totalVisitors": {
        ".write": "newData.isNumber() && (!data.exists() ? newData.val() === 1 : newData.val() === data.val() + 1)"
      },
      "downloads": {
        ".write": "newData.isNumber() && (!data.exists() ? newData.val() === 1 : newData.val() === data.val() + 1)"
      }
    }
  }
}
