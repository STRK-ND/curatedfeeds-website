# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# Firebase
.firebase/
.firebase.hosting.cache
.firebase.*.cache

# MCP servers / tooling
.mcp-gsc/

# Cloudflare Wrangler local emulator state (machine-local)
.wrangler/

# APK release artifacts (hosted on Cloudflare R2, not in the repo)
*.apk

# Windows junk
nul

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# backlink bot browser profile (machine-local session cookies)
/scripts/profile/

# backlink tooling (holds third-party account credentials and tokens)
/scripts/backlinks/

# typescript
*.tsbuildinfo
next-env.d.ts

# stale static exports and design-inspector working files
/out-old*/
/out_*/
/.taste-skill/
/.playwright-mcp/
/.hallmark/
/.perch/

# design exploration working files
/samples/

# backlink tooling caches
__pycache__/
**/venv/
