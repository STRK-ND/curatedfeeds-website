# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# Playwright verification runs (browser artifacts; regenerated on each run)
/playwright-report/
/test-results/
/blob-report/

# Firebase
.firebase/
.firebase.hosting.cache
.firebase.*.cache

# MCP servers / tooling
.mcp-gsc/

# AI assistant tool working dirs (local agent/design scratch state, not site content)
/.kilo/
/.kilocode/
/.kombai/

# personal editor/assistant settings; the shared ones (.agentation/config.json)
# stay tracked, ".local" files are machine-specific
/.claude/settings.local.json

# Cloudflare Wrangler local emulator state (machine-local)
.wrangler/

# APK release artifacts (hosted on Cloudflare R2, not in the repo)
*.apk

# Windows junk
nul
Thumbs.db
desktop.ini

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# throwaway local verification scripts (ad-hoc browser/runtime checks; the
# durable ones live under scripts/ and stay tracked)
/_verify-*.mjs

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# backlink bot browser profile (machine-local session cookies)
/scripts/profile/

# backlink tooling (holds third-party account credentials and tokens)
/scripts/backlinks/

# typescript
*.tsbuildinfo
next-env.d.ts

# stale static exports and design-inspector working files
/out-old*/
/out_*/
/.taste-skill/
/.playwright-mcp/
/.hallmark/
/.perch/

# design exploration working files
/samples/
/app-screen*/

# stale asset staging dir: nothing reads it (the one served image was copied to
# public/assets/train-window.jpg), this only holds the unused originals
/assets/

# backlink tooling caches
__pycache__/
**/venv/

# local-only research: never commit or push to GitHub
/seo-research/
/growth-system/
/perch-research/
/deliverable-*
Semrush-*.pdf
