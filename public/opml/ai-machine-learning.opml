<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>Curated Feeds - AI &amp; Machine Learning OPML Bundle (2027)</title>
    <dateCreated>Sun, 22 Nov 2026 00:00:00 GMT</dateCreated>
    <docs>http://opml.org/spec2.opml</docs>
  </head>
  <body>
    <outline text="AI &amp; Machine Learning" title="AI &amp; Machine Learning">
      <outline type="rss" text="OpenAI News" title="OpenAI News" xmlUrl="https://openai.com/news/rss.xml" description="Official research releases and announcements" />
      <outline type="rss" text="Google DeepMind" title="Google DeepMind" xmlUrl="https://deepmind.google/blog/rss.xml" description="Frontier AI research and architecture logs" />
      <outline type="rss" text="MIT Tech Review AI" title="MIT Tech Review AI" xmlUrl="https://www.technologyreview.com/topic/artificial-intelligence/feed" description="Analysis of societal and industrial AI impact" />
      <outline type="rss" text="ArXiv CS.AI Updates" title="ArXiv CS.AI Updates" xmlUrl="https://rss.arxiv.org/rss/cs.AI" description="Daily pre-print paper abstracts" />
      <outline type="rss" text="Hugging Face Blog" title="Hugging Face Blog" xmlUrl="https://huggingface.co/blog/feed.xml" description="Open source models and datasets" />
      <outline type="rss" text="Latent Space" title="Latent Space" xmlUrl="https://www.latent.space/feed" description="AI engineer podcast and deep-dives" />
    </outline>

  </body>
</opml>
