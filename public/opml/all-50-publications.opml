  <body>
    <outline text="Technology" title="Technology">
      <outline type="rss" text="The Verge" title="The Verge" xmlUrl="https://www.theverge.com/rss/index.xml" htmlUrl="https://theverge.com" description="The Verge covers consumer technology, science, art, and culture. The official RSS feed delivers all headlines and feature stories without auto-playing video ads." />
      <outline type="rss" text="The Verge - Tech" title="The Verge - Tech" xmlUrl="https://www.theverge.com/rss/tech/index.xml" htmlUrl="https://theverge.com" />
      <outline type="rss" text="The Verge - Reviews" title="The Verge - Reviews" xmlUrl="https://www.theverge.com/rss/reviews/index.xml" htmlUrl="https://theverge.com" />
      <outline type="rss" text="Ars Technica" title="Ars Technica" xmlUrl="https://feeds.arstechnica.com/arstechnica/index" htmlUrl="https://arstechnica.com" description="Ars Technica provides the rigorous technical depth that mainstream tech journalism skips. The feed delivers complete summaries and article links." />
      <outline type="rss" text="Ars Technica - Information Technology" title="Ars Technica - Information Technology" xmlUrl="https://feeds.arstechnica.com/arstechnica/technology-lab" htmlUrl="https://arstechnica.com" />
      <outline type="rss" text="Ars Technica - Science" title="Ars Technica - Science" xmlUrl="https://feeds.arstechnica.com/arstechnica/science" htmlUrl="https://arstechnica.com" />
      <outline type="rss" text="Engadget" title="Engadget" xmlUrl="https://www.engadget.com/rss.xml" htmlUrl="https://engadget.com" description="Engadget covers mobile hardware, audio equipment, home entertainment, and gaming tech." />
      <outline type="rss" text="CNET" title="CNET" xmlUrl="https://www.cnet.com/rss/news/" htmlUrl="https://cnet.com" description="CNET tests consumer technology products to help people buy smart." />
    </outline>
    <outline text="Startups &amp; Tech" title="Startups &amp; Tech">
      <outline type="rss" text="TechCrunch" title="TechCrunch" xmlUrl="https://techcrunch.com/feed/" htmlUrl="https://techcrunch.com" description="TechCrunch is the premier tech startup intelligence outlet. Follow every Series A announcement and founder move directly in your local feed reader." />
      <outline type="rss" text="TechCrunch - Startups" title="TechCrunch - Startups" xmlUrl="https://techcrunch.com/category/startups/feed/" htmlUrl="https://techcrunch.com" />
      <outline type="rss" text="TechCrunch - Venture Capital" title="TechCrunch - Venture Capital" xmlUrl="https://techcrunch.com/category/venture/feed/" htmlUrl="https://techcrunch.com" />
    </outline>
    <outline text="Technology &amp; Culture" title="Technology &amp; Culture">
      <outline type="rss" text="Wired" title="Wired" xmlUrl="https://www.wired.com/feed/rss" htmlUrl="https://wired.com" description="Wired chronicles how technology alters culture, politics, and the global economy. Subscribe cleanly to avoid intrusive subscription paywall modals." />
      <outline type="rss" text="Wired - Business" title="Wired - Business" xmlUrl="https://www.wired.com/feed/category/business/latest/rss" htmlUrl="https://wired.com" />
      <outline type="rss" text="Wired - Science" title="Wired - Science" xmlUrl="https://www.wired.com/feed/category/science/latest/rss" htmlUrl="https://wired.com" />
    </outline>
    <outline text="Developer" title="Developer">
      <outline type="rss" text="Hacker News" title="Hacker News" xmlUrl="https://news.ycombinator.com/rss" htmlUrl="https://news.ycombinator.com" description="Hacker News surfaces high-signal links curated by global software practitioners and founders." />
    </outline>
    <outline text="World News" title="World News">
      <outline type="rss" text="BBC News" title="BBC News" xmlUrl="https://feeds.bbci.co.uk/news/rss.xml" htmlUrl="https://bbc.com" description="BBC News delivers impartial international news reporting without advertising bias or sensationalism." />
      <outline type="rss" text="BBC News - World" title="BBC News - World" xmlUrl="https://feeds.bbci.co.uk/news/world/rss.xml" htmlUrl="https://bbc.com" />
      <outline type="rss" text="BBC News - Technology" title="BBC News - Technology" xmlUrl="https://feeds.bbci.co.uk/news/technology/rss.xml" htmlUrl="https://bbc.com" />
      <outline type="rss" text="Associated Press" title="Associated Press" xmlUrl="https://apnews.com/feed" htmlUrl="https://apnews.com" description="The Associated Press produces essential investigative wire news used by thousands of global publications." />
