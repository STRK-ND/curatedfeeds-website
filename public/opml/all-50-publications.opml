      <outline type="rss" text="Science Magazine" title="Science Magazine" xmlUrl="https://www.science.org/rss/news_current.xml" htmlUrl="https://science.org" description="Published by AAAS, Science covers cutting-edge findings in medicine, astronomy, and environmental science." />
      <outline type="rss" text="Scientific American" title="Scientific American" xmlUrl="http://rss.sciam.com/ScientificAmerican-Global" htmlUrl="https://scientificamerican.com" description="Scientific American explains complex scientific principles with clarity and elegance." />
