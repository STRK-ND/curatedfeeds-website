    </outline>
    <outline text="Enterprise Tech" title="Enterprise Tech">
      <outline type="rss" text="ZDNet" title="ZDNet" xmlUrl="https://www.zdnet.com/news/rss.xml" htmlUrl="https://zdnet.com" description="ZDNet covers B2B software, enterprise hardware deployments, and CIO priorities." />
