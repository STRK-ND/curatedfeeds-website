    <outline text="World &amp; Markets" title="World &amp; Markets">
      <outline type="rss" text="Reuters" title="Reuters" xmlUrl="https://www.reutersagency.com/feed/?best-topics=business-finance&amp;post_type=best" htmlUrl="https://reuters.com" description="Reuters is the trusted backbone of global financial journalism and factual wire news." />
