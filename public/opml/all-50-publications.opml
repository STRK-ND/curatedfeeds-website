    <outline text="Gaming" title="Gaming">
      <outline type="rss" text="Polygon" title="Polygon" xmlUrl="https://www.polygon.com/rss/index.xml" htmlUrl="https://polygon.com" description="Polygon covers gaming narrative, studio features, and streaming entertainment." />
      <outline type="rss" text="IGN" title="IGN" xmlUrl="https://feeds.feedburner.com/ign/all" htmlUrl="https://ign.com" description="The largest global entertainment and video game news network." />
      <outline type="rss" text="Kotaku" title="Kotaku" xmlUrl="https://kotaku.com/rss" htmlUrl="https://kotaku.com" description="Kotaku covers video games, the people who make them, and gaming culture." />
