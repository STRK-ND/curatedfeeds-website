    <outline text="PC Gaming" title="PC Gaming">
      <outline type="rss" text="Rock Paper Shotgun" title="Rock Paper Shotgun" xmlUrl="https://www.rockpapershotgun.com/feed" htmlUrl="https://rockpapershotgun.com" description="Thoughtful PC gaming criticism, hardware guides, and independent game spotlights." />
    </outline>
    <outline text="Culture &amp; Politics" title="Culture &amp; Politics">
      <outline type="rss" text="The Atlantic" title="The Atlantic" xmlUrl="https://www.theatlantic.com/feed/all/" htmlUrl="https://theatlantic.com" description="The Atlantic publishes consequential essays on democracy, ideas, and modern culture." />
