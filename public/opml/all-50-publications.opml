    <outline text="Web Design" title="Web Design">
      <outline type="rss" text="A List Apart" title="A List Apart" xmlUrl="https://alistapart.com/feed/" htmlUrl="https://alistapart.com" description="A List Apart explores the design, development, and meaning of web content." />
    </outline>
    <outline text="Apple &amp; Tech" title="Apple &amp; Tech">
      <outline type="rss" text="Daring Fireball" title="Daring Fireball" xmlUrl="https://daringfireball.net/feeds/main" htmlUrl="https://daringfireball.net" description="The premier independent voice on Apple, operating continuously since 2002." />
    </outline>
    <outline text="Apple" title="Apple">
