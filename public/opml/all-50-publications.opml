    <outline text="World &amp; Opinion" title="World &amp; Opinion">
      <outline type="rss" text="The Guardian" title="The Guardian" xmlUrl="https://www.theguardian.com/world/rss" htmlUrl="https://theguardian.com" description="The Guardian provides open, reader-funded journalism with extensive international and climate coverage." />
