    <outline text="Android" title="Android">
      <outline type="rss" text="Android Police" title="Android Police" xmlUrl="https://www.androidpolice.com/feed/" htmlUrl="https://androidpolice.com" description="The definitive news site for Android ecosystem enthusiasts, phone reviews, and Google software updates." />
