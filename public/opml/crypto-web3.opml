    <outline text="Crypto &amp; Web3" title="Crypto &amp; Web3">
      <outline type="rss" text="CoinDesk" title="CoinDesk" xmlUrl="https://www.coindesk.com/arc/outboundfeeds/rss/" description="Global regulatory coverage, institutional market dynamics, and blockchain developments." />
      <outline type="rss" text="Cointelegraph" title="Cointelegraph" xmlUrl="https://cointelegraph.com/rss" description="Cryptocurrency market news, policy reports, and technology deep-dives." />
      <outline type="rss" text="Vitalik Buterin’s Website" title="Vitalik Buterin’s Website" xmlUrl="https://vitalik.eth.limo/feed.xml" description="Foundational essays on Ethereum roadmap, cryptoeconomics, and decentralized governance." />
